# Windows SDK/CRT tree prepared by xwin with its default directory layout.
set(UNGYP_WINDOWS_SDK "" CACHE PATH "Absolute path to the xwin SDK root")
set(UNGYP_WINDOWS_ARCH x86_64 CACHE STRING "Windows target: x86_64, aarch64 or x86")
set(UNGYP_LLVM_ROOT "" CACHE PATH "LLVM installation prefix (empty uses PATH)")
if(NOT IS_ABSOLUTE "${UNGYP_WINDOWS_SDK}" OR NOT UNGYP_WINDOWS_ARCH MATCHES "^(x86_64|aarch64|x86)$")
    message(FATAL_ERROR "Set UNGYP_WINDOWS_SDK to an absolute SDK path and UNGYP_WINDOWS_ARCH to x86_64, aarch64 or x86")
endif()
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR "${UNGYP_WINDOWS_ARCH}")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    UNGYP_WINDOWS_SDK UNGYP_WINDOWS_ARCH UNGYP_LLVM_ROOT)

find_program(CMAKE_C_COMPILER NAMES clang-cl HINTS "${UNGYP_LLVM_ROOT}/bin" REQUIRED)
set(CMAKE_CXX_COMPILER "${CMAKE_C_COMPILER}")
find_program(CMAKE_LINKER NAMES lld-link HINTS "${UNGYP_LLVM_ROOT}/bin" REQUIRED)
find_program(CMAKE_AR NAMES llvm-lib HINTS "${UNGYP_LLVM_ROOT}/bin" REQUIRED)
find_program(CMAKE_MT NAMES llvm-mt HINTS "${UNGYP_LLVM_ROOT}/bin" REQUIRED)
find_program(CMAKE_RC_COMPILER NAMES llvm-rc HINTS "${UNGYP_LLVM_ROOT}/bin" REQUIRED)
set(target_arch "${UNGYP_WINDOWS_ARCH}")
if(target_arch STREQUAL "x86")
    set(target_arch i686)
endif()
set(CMAKE_C_COMPILER_TARGET "${target_arch}-pc-windows-msvc")
set(CMAKE_CXX_COMPILER_TARGET "${CMAKE_C_COMPILER_TARGET}")

# /X prevents implicit host SDK includes. All SDK and CRT paths are explicit.
set(sdk_includes "/X")
foreach(directory crt/include sdk/include/ucrt sdk/include/shared sdk/include/um sdk/include/winrt)
    string(APPEND sdk_includes " /imsvc\"${UNGYP_WINDOWS_SDK}/${directory}\"")
endforeach()
set(CMAKE_C_FLAGS_INIT "${sdk_includes}")
set(CMAKE_CXX_FLAGS_INIT "${sdk_includes}")
set(sdk_libraries "")
foreach(directory crt/lib sdk/lib/ucrt sdk/lib/um)
    string(APPEND sdk_libraries " /libpath:\"${UNGYP_WINDOWS_SDK}/${directory}/${UNGYP_WINDOWS_ARCH}\"")
endforeach()
set(CMAKE_EXE_LINKER_FLAGS_INIT "${sdk_libraries}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${sdk_libraries}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${sdk_libraries}")
list(APPEND CMAKE_FIND_ROOT_PATH "${UNGYP_WINDOWS_SDK}")
list(REMOVE_DUPLICATES CMAKE_FIND_ROOT_PATH)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
