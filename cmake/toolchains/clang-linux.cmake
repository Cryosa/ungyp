# Host LLVM tools with an explicit Linux sysroot and target runtime libraries.
set(UNGYP_LLVM_ROOT "" CACHE PATH "LLVM installation prefix (empty uses PATH)")
set(UNGYP_LINUX_TARGET "" CACHE STRING "Linux target: x86_64-linux-gnu or aarch64-linux-gnu")
if(NOT UNGYP_LINUX_TARGET MATCHES "^(x86_64|aarch64)-linux-gnu$")
    message(FATAL_ERROR "Set UNGYP_LINUX_TARGET to x86_64-linux-gnu or aarch64-linux-gnu")
endif()
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR "${CMAKE_MATCH_1}")
if(NOT IS_ABSOLUTE "${CMAKE_SYSROOT}")
    message(FATAL_ERROR "Set CMAKE_SYSROOT to the absolute path of the target Linux sysroot")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES UNGYP_LLVM_ROOT UNGYP_LINUX_TARGET)

find_program(CMAKE_C_COMPILER NAMES clang HINTS "${UNGYP_LLVM_ROOT}/bin" REQUIRED)
find_program(CMAKE_CXX_COMPILER NAMES clang++ HINTS "${UNGYP_LLVM_ROOT}/bin" REQUIRED)
find_program(CMAKE_LINKER NAMES ld.lld HINTS "${UNGYP_LLVM_ROOT}/bin" REQUIRED)
find_program(CMAKE_AR NAMES llvm-ar HINTS "${UNGYP_LLVM_ROOT}/bin" REQUIRED)
find_program(CMAKE_RANLIB NAMES llvm-ranlib HINTS "${UNGYP_LLVM_ROOT}/bin" REQUIRED)
set(CMAKE_C_COMPILER_TARGET "${UNGYP_LINUX_TARGET}")
set(CMAKE_CXX_COMPILER_TARGET "${UNGYP_LINUX_TARGET}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "--ld-path=\"${CMAKE_LINKER}\"")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
