# A standalone Zig distribution supplies the Linux compiler, linker and libc.
set(UNGYP_ZIG_EXECUTABLE "" CACHE FILEPATH "Absolute path to zig")
set(UNGYP_ZIG_TARGET "" CACHE STRING "Linux target, e.g. x86_64-linux-gnu.2.28")
if(NOT IS_ABSOLUTE "${UNGYP_ZIG_EXECUTABLE}" OR NOT UNGYP_ZIG_TARGET MATCHES "^([^-]+)-linux-(gnu|musl)(\\.[0-9.]+)?$")
    message(FATAL_ERROR "Set UNGYP_ZIG_EXECUTABLE to an absolute path and UNGYP_ZIG_TARGET to a Linux target (e.g. aarch64-linux-gnu.2.28)")
endif()
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR "${CMAKE_MATCH_1}")
set(CMAKE_C_COMPILER "${UNGYP_ZIG_EXECUTABLE}" cc -target "${UNGYP_ZIG_TARGET}")
set(CMAKE_CXX_COMPILER "${UNGYP_ZIG_EXECUTABLE}" c++ -target "${UNGYP_ZIG_TARGET}")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES UNGYP_ZIG_EXECUTABLE UNGYP_ZIG_TARGET)

# Use Zig's archiver for project dependencies as well as the module itself.
foreach(lang C CXX)
    set(CMAKE_${lang}_ARCHIVE_CREATE "\"${UNGYP_ZIG_EXECUTABLE}\" ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
    set(CMAKE_${lang}_ARCHIVE_APPEND "\"${UNGYP_ZIG_EXECUTABLE}\" ar q <TARGET> <LINK_FLAGS> <OBJECTS>")
    set(CMAKE_${lang}_ARCHIVE_FINISH "\"${UNGYP_ZIG_EXECUTABLE}\" ranlib <TARGET>")
endforeach()
get_filename_component(zig_directory "${UNGYP_ZIG_EXECUTABLE}" DIRECTORY)
list(APPEND CMAKE_FIND_ROOT_PATH "${zig_directory}/lib")
list(REMOVE_DUPLICATES CMAKE_FIND_ROOT_PATH)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
