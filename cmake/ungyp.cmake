include_guard(GLOBAL)
if(CMAKE_VERSION VERSION_LESS 3.24)
    message(FATAL_ERROR "ungyp requires CMake 3.24 or newer")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/internal/Platform.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/internal/NodeAPI.cmake")

set(UNGYP_RUNTIME node CACHE STRING "V8 target runtime: node or electron")
set_property(CACHE UNGYP_RUNTIME PROPERTY STRINGS node electron)
set(UNGYP_NODE_VERSION "" CACHE STRING "Explicit runtime version for V8 addons")
set(UNGYP_ARCH "" CACHE STRING "Optional target architecture assertion (does not select the compiler)")
set(UNGYP_NODE_ROOT "" CACHE PATH "Existing Node SDK root or include directory; bypasses downloads")
set(UNGYP_NODE_LIBRARY "" CACHE FILEPATH "Existing Windows node.lib for V8 addons")
set(UNGYP_DIST_URL "" CACHE STRING "Distribution mirror, without /v<version>")
option(UNGYP_OFFLINE "Disallow SDK downloads" OFF)
if(DEFINED ENV{LOCALAPPDATA} AND CMAKE_HOST_WIN32)
    set(_ungyp_cache "$ENV{LOCALAPPDATA}/ungyp/Cache")
elseif(DEFINED ENV{XDG_CACHE_HOME} AND NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
    set(_ungyp_cache "$ENV{XDG_CACHE_HOME}/ungyp")
elseif(DEFINED ENV{HOME})
    set(_ungyp_cache "$ENV{HOME}/.cache/ungyp")
else()
    set(_ungyp_cache "${CMAKE_BINARY_DIR}/.ungyp")
endif()
set(UNGYP_CACHE_DIR "${_ungyp_cache}" CACHE PATH "Shared verified SDK cache for V8 addons")
unset(_ungyp_cache)

# Full Node/V8 SDK, only for explicit V8 addons and the CMake.js bridge.
function(ungyp_setup)
    if(TARGET ungyp::node)
        return()
    endif()
    if(NOT CMAKE_C_COMPILER_LOADED AND NOT CMAKE_CXX_COMPILER_LOADED)
        message(FATAL_ERROR "ungyp: enable C or CXX in project() before ungyp_setup()")
    endif()
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/internal/Runtime.cmake")
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/internal/ABI.cmake")
    _ungyp_resolve_runtime()
    _ungyp_sdk("${UNGYP_RUNTIME}" "${UNGYP_RESOLVED_VERSION}"
        "${UNGYP_RESOLVED_ARCH}" "${UNGYP_RESOLVED_MIRROR}")
    _ungyp_sdk_definitions("${UNGYP_SDK_INCLUDE}" "${UNGYP_RUNTIME}" definitions)
    add_library(ungyp::node INTERFACE IMPORTED GLOBAL)
    set_target_properties(ungyp::node PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${UNGYP_SDK_INCLUDE}"
        INTERFACE_COMPILE_DEFINITIONS "${definitions}"
        UNGYP_VERSION "${UNGYP_RESOLVED_VERSION}"
        UNGYP_ARCH "${UNGYP_RESOLVED_ARCH}"
        UNGYP_RUNTIME "${UNGYP_RUNTIME}"
        UNGYP_SDK_ROOT "${UNGYP_SDK_ROOT}")
    if(WIN32)
        target_link_libraries(ungyp::node INTERFACE "${UNGYP_SDK_LIBRARY}")
    endif()
    _ungyp_platform_setup(ungyp::node)
    message(STATUS "ungyp: ${UNGYP_RUNTIME} ${UNGYP_RESOLVED_VERSION} (${UNGYP_RESOLVED_ARCH})")
endfunction()

function(ungyp_configure_target target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "V8" "NAPI_VERSION" "")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "ungyp_configure_target: invalid arguments: ${ARG_UNPARSED_ARGUMENTS};${ARG_KEYWORDS_MISSING_VALUES}")
    endif()
    _ungyp_configure_target("${target}" "${ARG_NAPI_VERSION}" "${ARG_V8}")
endfunction()

function(_ungyp_configure_target target napi_version use_v8)
    get_target_property(type "${target}" TYPE)
    if(NOT type MATCHES "^(MODULE_LIBRARY|SHARED_LIBRARY)$")
        message(FATAL_ERROR "ungyp: '${target}' must be a MODULE or SHARED library")
    endif()
    if(use_v8)
        if(NOT napi_version STREQUAL "")
            message(FATAL_ERROR "ungyp: V8 and NAPI_VERSION are mutually exclusive")
        endif()
        ungyp_setup()
        set(api ungyp::node)
        if(CMAKE_CXX_COMPILER_LOADED)
            target_compile_features("${target}" PRIVATE cxx_std_20)
        endif()
    else()
        if(napi_version STREQUAL "")
            set(napi_version 8)
        endif()
        if(NOT napi_version MATCHES "^([1-9]|10)$")
            message(FATAL_ERROR "ungyp: bundled headers support NAPI_VERSION 1 through 10")
        endif()
        _ungyp_setup_napi()
        set(api ungyp::napi)
        target_compile_definitions("${target}" PRIVATE "NAPI_VERSION=${napi_version}")
    endif()
    target_link_libraries("${target}" PRIVATE "${api}")
    string(MAKE_C_IDENTIFIER "${target}" module_name)
    target_compile_definitions("${target}" PRIVATE "NODE_GYP_MODULE_NAME=${module_name}")
    set_target_properties("${target}" PROPERTIES PREFIX "" SUFFIX ".node"
        POSITION_INDEPENDENT_CODE ON)
    if(NOT DEFINED CMAKE_CXX_SCAN_FOR_MODULES)
        set_property(TARGET "${target}" PROPERTY CXX_SCAN_FOR_MODULES OFF)
    endif()
    if(WIN32)
        get_target_property(hook "${api}" UNGYP_DELAY_LOAD_HOOK)
        if(NOT CMAKE_C_COMPILER_LOADED)
            set_source_files_properties("${hook}" PROPERTIES LANGUAGE CXX)
        endif()
        target_sources("${target}" PRIVATE "${hook}")
        # Keep CRT allocation inside the addon; the host's Debug CRT is not needed.
        get_target_property(runtime_library "${target}" MSVC_RUNTIME_LIBRARY)
        if(NOT runtime_library)
            set_property(TARGET "${target}" PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
        endif()
        target_compile_definitions("${target}" PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
    endif()
endfunction()

function(ungyp_addon target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "V8" "NAPI_VERSION" "SOURCES")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR NOT ARG_SOURCES)
        message(FATAL_ERROR "Usage: ungyp_addon(target SOURCES file... [NAPI_VERSION n | V8])")
    endif()
    add_library("${target}" MODULE ${ARG_SOURCES})
    _ungyp_configure_target("${target}" "${ARG_NAPI_VERSION}" "${ARG_V8}")
endfunction()
