# 兼容Cmake-js的CMake模块
include("${CMAKE_CURRENT_LIST_DIR}/ungyp.cmake")
ungyp_setup()
get_target_property(CMAKE_JS_INC ungyp::node INTERFACE_INCLUDE_DIRECTORIES)
set(CMAKE_JS_LIB ungyp::node)
set(CMAKE_JS_SRC "")
set(CMAKE_JS_NODELIB_DEF "")
set(CMAKE_JS_NODELIB_TARGET "")
if(WIN32)
    get_target_property(CMAKE_JS_SRC ungyp::node UNGYP_DELAY_LOAD_HOOK)
    if(NOT CMAKE_C_COMPILER_LOADED)
        set_source_files_properties("${CMAKE_JS_SRC}" PROPERTIES LANGUAGE CXX)
    endif()
endif()
get_target_property(NODE_RUNTIME ungyp::node UNGYP_RUNTIME)
get_target_property(NODE_RUNTIMEVERSION ungyp::node UNGYP_VERSION)
get_target_property(NODE_ARCH ungyp::node UNGYP_ARCH)
# Identification of this bridge, not a claim to emulate a cmake-js release.
set(UNGYP_VERSION 1.0.0)
