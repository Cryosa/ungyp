include_guard(GLOBAL)

set(UNGYP_DOWNLOAD_TIMEOUT 300 CACHE STRING "Download timeout in seconds")
set(UNGYP_DOWNLOAD_INACTIVITY_TIMEOUT 30 CACHE STRING "Download inactivity timeout in seconds")

# The SDK lock is held by the caller. Publish only verified, complete files.
function(_ungyp_download url destination sha256)
    if(EXISTS "${destination}")
        set(downloaded "${destination}")
    else()
        if(UNGYP_OFFLINE)
            message(FATAL_ERROR "ungyp: offline cache miss: ${destination}")
        endif()
        get_filename_component(parent "${destination}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        if(NOT DEFINED CMAKE_TLS_VERIFY)
            set(CMAKE_TLS_VERIFY ON)
        endif()
        message(STATUS "ungyp: downloading ${url}")
        set(downloaded "${destination}.part")
        file(DOWNLOAD "${url}" "${downloaded}" STATUS status
            TIMEOUT "${UNGYP_DOWNLOAD_TIMEOUT}"
            INACTIVITY_TIMEOUT "${UNGYP_DOWNLOAD_INACTIVITY_TIMEOUT}")
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            file(REMOVE "${downloaded}")
            message(FATAL_ERROR "ungyp: ${url}: ${status}. Configure UNGYP_DIST_URL, proxy environment or CMAKE_TLS_CAINFO as needed.")
        endif()
    endif()
    if(sha256)
        file(SHA256 "${downloaded}" actual)
        if(NOT actual STREQUAL sha256)
            if(downloaded MATCHES "\\.part$")
                file(REMOVE "${downloaded}")
            endif()
            message(FATAL_ERROR "ungyp: SHA256 mismatch: ${destination}. Remove this file and configure again.")
        endif()
    endif()
    if(NOT downloaded STREQUAL destination)
        file(RENAME "${downloaded}" "${destination}")
    endif()
endfunction()

function(_ungyp_checksum manifest filename output)
    file(STRINGS "${manifest}" lines)
    foreach(line IN LISTS lines)
        if(line MATCHES "^([0-9A-Fa-f]+)[ \t]+\\*?(.+)$")
            set(hash "${CMAKE_MATCH_1}")
            set(name "${CMAKE_MATCH_2}")
            string(LENGTH "${hash}" length)
            if(name STREQUAL filename AND length EQUAL 64)
                string(TOLOWER "${hash}" hash)
                set(${output} "${hash}" PARENT_SCOPE)
                return()
            endif()
        endif()
    endforeach()
    message(FATAL_ERROR "ungyp: no SHA256 entry for ${filename} in ${manifest}")
endfunction()

function(_ungyp_library_path runtime arch output)
    if(runtime STREQUAL "node")
        if(arch STREQUAL "ia32")
            set(arch x86)
        endif()
        set(path "win-${arch}/node.lib")
    elseif(arch STREQUAL "ia32")
        set(path node.lib)
    else()
        set(path "${arch}/node.lib")
    endif()
    set(${output} "${path}" PARENT_SCOPE)
endfunction()

function(_ungyp_fetch_sdk runtime version arch mirror output_root output_library)
    string(REGEX REPLACE "/+$" "" mirror "${mirror}")
    string(SHA256 mirror_hash "${mirror}")
    string(SUBSTRING "${mirror_hash}" 0 16 mirror_hash)
    get_filename_component(cache_base "${UNGYP_CACHE_DIR}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
    # Headers are architecture independent. Libraries share the same SDK entry.
    set(cache "${cache_base}/${runtime}-v${version}-${mirror_hash}")
    if(runtime STREQUAL "electron")
        set(archive_root node_headers)
        set(archive "node-v${version}-headers.tar.gz")
    else()
        set(archive_root "node-v${version}")
        set(archive "node-v${version}-headers.tar.xz")
    endif()
    set(root "${cache}/headers/${archive_root}")
    set(library "")
    if(WIN32 AND NOT UNGYP_NODE_LIBRARY)
        _ungyp_library_path("${runtime}" "${arch}" libpath)
        set(library "${cache}/${libpath}")
    endif()
    set(${output_root} "${root}" PARENT_SCOPE)
    set(${output_library} "${library}" PARENT_SCOPE)

    # The normal path does no network access, hashing, extraction or locking.
    if(EXISTS "${cache}/headers/ready" AND EXISTS "${root}/include/node/node_api.h"
            AND EXISTS "${root}/include/node/node.h"
            AND (NOT library OR (EXISTS "${library}" AND EXISTS "${library}.ready")))
        return()
    endif()
    file(MAKE_DIRECTORY "${cache}")
    file(LOCK "${cache}/sdk.lock" GUARD FUNCTION TIMEOUT 120)
    set(base "${mirror}/v${version}")
    set(manifest "${cache}/SHASUMS256.txt")
    _ungyp_download("${base}/SHASUMS256.txt" "${manifest}" "")
    if(NOT EXISTS "${cache}/headers/ready" OR NOT EXISTS "${root}/include/node/node_api.h"
            OR NOT EXISTS "${root}/include/node/node.h")
        _ungyp_checksum("${manifest}" "${archive}" hash)
        _ungyp_download("${base}/${archive}" "${cache}/${archive}" "${hash}")
        file(REMOVE_RECURSE "${cache}/extracting")
        file(MAKE_DIRECTORY "${cache}/extracting")
        file(ARCHIVE_EXTRACT INPUT "${cache}/${archive}" DESTINATION "${cache}/extracting")
        if(NOT EXISTS "${cache}/extracting/${archive_root}/include/node/node_api.h"
                OR NOT EXISTS "${cache}/extracting/${archive_root}/include/node/node.h")
            message(FATAL_ERROR "ungyp: invalid headers archive: ${archive}")
        endif()
        file(WRITE "${cache}/extracting/ready" "${hash}")
        file(REMOVE_RECURSE "${cache}/headers")
        file(RENAME "${cache}/extracting" "${cache}/headers")
    endif()
    if(library AND (NOT EXISTS "${library}" OR NOT EXISTS "${library}.ready"))
        _ungyp_checksum("${manifest}" "${libpath}" hash)
        _ungyp_download("${base}/${libpath}" "${library}" "${hash}")
        file(WRITE "${library}.ready" "${hash}")
    endif()
endfunction()
