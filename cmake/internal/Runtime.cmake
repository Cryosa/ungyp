include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/Platform.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Download.cmake")

function(_ungyp_sdk runtime version arch mirror)
    set(root "${UNGYP_NODE_ROOT}")
    set(library "${UNGYP_NODE_LIBRARY}")
    if(root)
        get_filename_component(root "${root}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        if(WIN32 AND NOT library)
            _ungyp_library_path("${runtime}" "${arch}" libpath)
            set(library "${root}/${libpath}")
        endif()
    else()
        _ungyp_fetch_sdk("${runtime}" "${version}" "${arch}" "${mirror}" root downloaded_library)
        if(NOT library)
            set(library "${downloaded_library}")
        endif()
    endif()
    _ungyp_find_headers("${root}" include_dir)
    if(UNGYP_NODE_ROOT AND runtime STREQUAL "node")
        file(READ "${include_dir}/node_version.h" header)
        foreach(part MAJOR MINOR PATCH)
            string(REGEX MATCH "#[ \t]*define[ \t]+NODE_${part}_VERSION[ \t]+([0-9]+)" match "${header}")
            set(header_${part} "${CMAKE_MATCH_1}")
        endforeach()
        set(header_version "${header_MAJOR}.${header_MINOR}.${header_PATCH}")
        string(REGEX REPLACE "-.*$" "" expected_version "${version}")
        if(NOT header_version STREQUAL expected_version)
            message(FATAL_ERROR "ungyp: SDK headers are Node ${header_version}, but target is ${version}")
        endif()
    endif()
    if(WIN32)
        get_filename_component(library "${library}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        if(NOT EXISTS "${library}")
            message(FATAL_ERROR "ungyp: node.lib not found: ${library}. Set UNGYP_NODE_LIBRARY for a custom SDK layout.")
        endif()
    endif()
    set(UNGYP_SDK_ROOT "${root}" PARENT_SCOPE)
    set(UNGYP_SDK_INCLUDE "${include_dir}" PARENT_SCOPE)
    set(UNGYP_SDK_LIBRARY "${library}" PARENT_SCOPE)
endfunction()

function(_ungyp_resolve_runtime)
    if(NOT UNGYP_RUNTIME MATCHES "^(node|electron)$")
        message(FATAL_ERROR "ungyp: UNGYP_RUNTIME must be node or electron")
    endif()
    set(version "${UNGYP_NODE_VERSION}")
    if(NOT version)
        message(FATAL_ERROR "ungyp: V8 addons require an explicit UNGYP_NODE_VERSION (the ${UNGYP_RUNTIME} version).")
    endif()
    string(REGEX REPLACE "^v" "" version "${version}")
    if(NOT version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$")
        message(FATAL_ERROR "ungyp: invalid UNGYP_NODE_VERSION '${version}'; use a full version such as 22.14.0.")
    endif()
    _ungyp_architecture(arch)
    if(UNGYP_DIST_URL)
        set(mirror "${UNGYP_DIST_URL}")
    elseif(UNGYP_RUNTIME STREQUAL "electron")
        set(mirror "https://artifacts.electronjs.org/headers/dist")
    else()
        set(mirror "https://nodejs.org/dist")
    endif()
    set(UNGYP_RESOLVED_VERSION "${version}" PARENT_SCOPE)
    set(UNGYP_RESOLVED_ARCH "${arch}" PARENT_SCOPE)
    set(UNGYP_RESOLVED_MIRROR "${mirror}" PARENT_SCOPE)
endfunction()

function(_ungyp_find_headers root output)
    if(IS_DIRECTORY "${root}/include/node")
        set(root "${root}/include/node")
    endif()
    if(NOT EXISTS "${root}/node.h" OR NOT EXISTS "${root}/node_api.h")
        message(FATAL_ERROR "ungyp: node.h and node_api.h were not found in ${root}")
    endif()
    set(${output} "${root}" PARENT_SCOPE)
endfunction()
