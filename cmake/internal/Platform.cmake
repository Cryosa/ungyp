include_guard(GLOBAL)

function(_ungyp_normalize_arch value output)
    string(TOLOWER "${value}" value)
    if(value MATCHES "^(x64|x86_64|amd64)$")
        set(arch x64)
    elseif(value MATCHES "^(x86|ia32|i[3-6]86|win32)$")
        set(arch ia32)
    elseif(value MATCHES "^(arm64|aarch64)$")
        set(arch arm64)
    elseif(value MATCHES "^(arm|armv[5-8].*)$")
        set(arch arm)
    elseif(value MATCHES "^(ppc64|ppc64le|s390x|riscv64|loong64)$")
        set(arch "${value}")
    else()
        message(FATAL_ERROR "ungyp: unsupported architecture '${value}'; use a matching CMake toolchain.")
    endif()
    set(${output} "${arch}" PARENT_SCOPE)
endfunction()

function(_ungyp_architecture output)
    # The compiler target is authoritative; no host runtime is inspected.
    if(CMAKE_VS_PLATFORM_NAME)
        set(compiler_arch "${CMAKE_VS_PLATFORM_NAME}")
    elseif(CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
        set(compiler_arch "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
    elseif(CMAKE_C_COMPILER_ARCHITECTURE_ID)
        set(compiler_arch "${CMAKE_C_COMPILER_ARCHITECTURE_ID}")
    else()
        set(compiler_arch "${CMAKE_SYSTEM_PROCESSOR}")
    endif()
    if(APPLE AND CMAKE_OSX_ARCHITECTURES)
        list(LENGTH CMAKE_OSX_ARCHITECTURES osx_arch_count)
        if(NOT osx_arch_count EQUAL 1)
            message(FATAL_ERROR "ungyp: V8 or UNGYP_ARCH requires a single CMAKE_OSX_ARCHITECTURES value. For Node-API universal builds, leave UNGYP_ARCH unset.")
        endif()
        set(compiler_arch "${CMAKE_OSX_ARCHITECTURES}")
    endif()
    _ungyp_normalize_arch("${compiler_arch}" arch)
    if(CMAKE_SIZEOF_VOID_P EQUAL 4 AND arch STREQUAL "x64")
        set(arch ia32)
    endif()
    if(UNGYP_ARCH)
        _ungyp_normalize_arch("${UNGYP_ARCH}" requested_arch)
        if(NOT arch STREQUAL requested_arch)
            message(FATAL_ERROR "ungyp: UNGYP_ARCH=${requested_arch} differs from the compiler target ${arch}. Select the architecture using -A or a CMake toolchain first.")
        endif()
    endif()
    if(WIN32 AND NOT arch MATCHES "^(x64|ia32|arm64)$")
        message(FATAL_ERROR "ungyp: no Windows import library mapping for ${arch}")
    endif()
    set(${output} "${arch}" PARENT_SCOPE)
endfunction()

function(_ungyp_platform_setup target)
    if(WIN32)
        if(NOT MSVC)
            message(FATAL_ERROR "ungyp: Windows requires an MSVC-compatible toolchain (MSVC or clang-cl)")
        endif()
        target_link_libraries("${target}" INTERFACE delayimp)
        target_link_options("${target}" INTERFACE /DELAYLOAD:node.exe)
        target_compile_options("${target}" INTERFACE "$<$<COMPILE_LANGUAGE:CXX>:/Zc:__cplusplus>")
        set_property(TARGET "${target}" PROPERTY UNGYP_DELAY_LOAD_HOOK
            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/win_delay_load_hook.c")
    elseif(APPLE)
        target_link_options("${target}" INTERFACE "LINKER:-undefined,dynamic_lookup")
    endif()
endfunction()
