cmake_minimum_required(VERSION 3.24)
include("${SOURCE_DIR}/cmake/internal/Platform.cmake")

function(check_architecture case)
    set(WIN32 OFF)
    set(APPLE OFF)
    set(CMAKE_SYSTEM_PROCESSOR x86_64)
    set(CMAKE_SIZEOF_VOID_P 8)
    set(CMAKE_VS_PLATFORM_NAME "")
    set(CMAKE_C_COMPILER_ARCHITECTURE_ID "")
    set(CMAKE_CXX_COMPILER_ARCHITECTURE_ID "")
    set(CMAKE_OSX_ARCHITECTURES "")

    if(case STREQUAL "vs_arm64")
        set(WIN32 ON)
        set(CMAKE_VS_PLATFORM_NAME ARM64)
        set(UNGYP_ARCH arm64)
    elseif(case STREQUAL "vs_x86")
        set(WIN32 ON)
        set(CMAKE_VS_PLATFORM_NAME Win32)
        set(CMAKE_SIZEOF_VOID_P 4)
        set(UNGYP_ARCH ia32)
    elseif(case STREQUAL "clang_cl_arm64")
        set(WIN32 ON)
        set(CMAKE_C_COMPILER_ARCHITECTURE_ID ARM64)
        set(UNGYP_ARCH arm64)
    elseif(case STREQUAL "linux_aarch64")
        set(CMAKE_SYSTEM_PROCESSOR aarch64)
        set(UNGYP_ARCH arm64)
    elseif(case STREQUAL "linux_armhf")
        set(CMAKE_SYSTEM_PROCESSOR armv7l)
        set(CMAKE_SIZEOF_VOID_P 4)
        set(UNGYP_ARCH arm)
    elseif(case STREQUAL "linux_multilib")
        set(CMAKE_SIZEOF_VOID_P 4)
        set(UNGYP_ARCH ia32)
    elseif(case STREQUAL "macos_arm64")
        set(APPLE ON)
        set(CMAKE_OSX_ARCHITECTURES arm64)
        set(UNGYP_ARCH arm64)
    endif()
    _ungyp_architecture(actual)
    if(NOT actual STREQUAL UNGYP_ARCH)
        message(FATAL_ERROR "${case}: expected ${UNGYP_ARCH}, got ${actual}")
    endif()
endfunction()

foreach(case vs_arm64 vs_x86 clang_cl_arm64 linux_aarch64 linux_armhf linux_multilib macos_arm64)
    check_architecture("${case}")
endforeach()
