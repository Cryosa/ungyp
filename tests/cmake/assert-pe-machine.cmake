cmake_minimum_required(VERSION 3.24)
# Inspect a cross-built DLL without executing it or requiring dumpbin/Node.
file(READ "${ADDON}" dos_header LIMIT 64 HEX)
string(SUBSTRING "${dos_header}" 0 4 magic)
if(NOT magic STREQUAL "4d5a")
    message(FATAL_ERROR "Not a PE image: ${ADDON}")
endif()
string(SUBSTRING "${dos_header}" 120 8 offset_le)
string(REGEX REPLACE "(..)(..)(..)(..)" "\\4\\3\\2\\1" offset "${offset_le}")
math(EXPR offset "0x${offset}")
file(READ "${ADDON}" pe_header OFFSET ${offset} LIMIT 6 HEX)
if(NOT pe_header STREQUAL "50450000${MACHINE}")
    message(FATAL_ERROR "Expected PE machine ${MACHINE}, got ${pe_header}: ${ADDON}")
endif()
message(STATUS "Verified PE machine ${MACHINE}: ${ADDON}")
