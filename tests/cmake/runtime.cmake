cmake_minimum_required(VERSION 3.24)
include("${SOURCE_DIR}/cmake/internal/Runtime.cmake")
if(CHILD)
    set(UNGYP_RUNTIME node)
    set(UNGYP_NODE_VERSION 22.14.0)
    set(CMAKE_SYSTEM_PROCESSOR x86_64)
    set(CMAKE_SIZEOF_VOID_P 8)
    if(CASE STREQUAL "invalid_version")
        set(UNGYP_NODE_VERSION "../../22")
    elseif(CASE STREQUAL "invalid_runtime")
        set(UNGYP_RUNTIME unsupported)
    elseif(CASE STREQUAL "architecture")
        set(UNGYP_ARCH arm64)
    elseif(CASE STREQUAL "node_version")
        set(UNGYP_NODE_VERSION "")
    elseif(CASE STREQUAL "electron_version")
        set(UNGYP_RUNTIME electron)
        set(UNGYP_NODE_VERSION "")
    elseif(CASE STREQUAL "universal_architecture")
        set(APPLE ON)
        set(CMAKE_OSX_ARCHITECTURES "x86_64;arm64")
    endif()
    _ungyp_resolve_runtime()
else()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${SOURCE_DIR}" "-DCASE=${CASE}"
        -DCHILD=ON -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    set(pattern_invalid_version "invalid UNGYP_NODE_VERSION")
    set(pattern_invalid_runtime "UNGYP_RUNTIME must be")
    set(pattern_architecture "differs from the compiler target")
    set(pattern_electron_version "explicit UNGYP_NODE_VERSION")
    set(pattern_node_version "explicit UNGYP_NODE_VERSION")
    set(pattern_universal_architecture "requires a single CMAKE_OSX_ARCHITECTURES")
    if(status EQUAL 0 OR NOT "${output}${error}" MATCHES "${pattern_${CASE}}")
        message(FATAL_ERROR "Expected ${CASE} rejection, got ${status}: ${output}${error}")
    endif()
endif()
