cmake_minimum_required(VERSION 3.24)
include("${SOURCE_DIR}/cmake/internal/Download.cmake")
if(NOT CHILD)
    cmake_path(IS_PREFIX TEST_ROOT "${TEST_DIR}" NORMALIZE owned)
    if(NOT owned OR TEST_DIR STREQUAL TEST_ROOT)
        message(FATAL_ERROR "Test directory must be inside TEST_ROOT")
    endif()
    file(REMOVE_RECURSE "${TEST_DIR}")
endif()
set(UNGYP_CACHE_DIR "${TEST_DIR}/cache")
set(UNGYP_OFFLINE OFF)
set(version 22.14.0)
set(archive "node-v${version}-headers.tar.xz")
set(dist "${TEST_DIR}/mirror/v${version}")
set(headers "${TEST_DIR}/input/node-v${version}/include/node")

# Each CTest owns a separate scratch directory, including spaces in the path.
if(NOT CHILD)
    file(MAKE_DIRECTORY "${headers}" "${dist}/win-x64" "${dist}/win-arm64")
    file(WRITE "${headers}/node.h" "/* test node.h */")
    file(WRITE "${headers}/node_api.h" "/* test node_api.h */")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cJf "${dist}/${archive}" "node-v${version}"
        WORKING_DIRECTORY "${TEST_DIR}/input" COMMAND_ERROR_IS_FATAL ANY)
    file(WRITE "${dist}/win-x64/node.lib" "test import library")
    file(COPY_FILE "${dist}/win-x64/node.lib" "${dist}/win-arm64/node.lib")
    if(CASE STREQUAL "invalid_archive")
        file(WRITE "${dist}/${archive}" "not an archive")
    endif()
    file(SHA256 "${dist}/${archive}" archive_hash)
    file(SHA256 "${dist}/win-x64/node.lib" library_hash)
    if(CASE STREQUAL "checksum")
        string(REPEAT 0 64 archive_hash)
    endif()
    if(CASE STREQUAL "missing_checksum")
        set(manifest "${archive_hash}  unrelated.tar.gz\n")
    else()
        set(manifest "${archive_hash}  ${archive}\n${library_hash} *win-x64/node.lib\n${library_hash}  win-arm64/node.lib\n")
    endif()
    file(WRITE "${dist}/SHASUMS256.txt" "${manifest}")
endif()
file(TO_CMAKE_PATH "${TEST_DIR}/mirror" mirror_path)
if(WIN32)
    set(mirror "file:///${mirror_path}")
else()
    set(mirror "file://${mirror_path}")
endif()
if(CHILD OR CASE STREQUAL "roundtrip")
    if(CASE STREQUAL "offline" OR CASE STREQUAL "offline_corrupt")
        set(UNGYP_OFFLINE ON)
    endif()
    _ungyp_fetch_sdk(node "${version}" x64 "${mirror}" root library)
    if(CASE STREQUAL "roundtrip")
        file(READ "${root}/include/node/node_api.h" content)
        if(NOT content STREQUAL "/* test node_api.h */")
            message(FATAL_ERROR "Unexpected extracted header")
        endif()
        # A complete cache needs neither the manifest nor the archive on hot runs.
        get_filename_component(cache "${root}/../.." ABSOLUTE)
        file(RENAME "${cache}/${archive}" "${cache}/${archive}.saved")
        file(RENAME "${cache}/SHASUMS256.txt" "${cache}/SHASUMS256.saved")
        set(UNGYP_OFFLINE ON)
        _ungyp_fetch_sdk(node "${version}" x64 "${mirror}" root library)
        file(RENAME "${cache}/${archive}.saved" "${cache}/${archive}")
        file(RENAME "${cache}/SHASUMS256.saved" "${cache}/SHASUMS256.txt")
        file(REMOVE "${root}/include/node/node_api.h")
        _ungyp_fetch_sdk(node "${version}" x64 "${mirror}" root library)
        if(NOT EXISTS "${root}/include/node/node_api.h")
            message(FATAL_ERROR "Offline extraction did not repair missing header")
        endif()
        set(UNGYP_OFFLINE OFF)
        _ungyp_fetch_sdk(node "${version}" arm64 "${mirror}" arm_root arm_library)
        if(NOT arm_root STREQUAL root)
            message(FATAL_ERROR "Architectures must share the extracted headers")
        endif()
        # A second runtime exercises Electron's separate library URL layout.
        set(UNGYP_OFFLINE OFF)
        file(MAKE_DIRECTORY "${dist}/x64")
        file(COPY_FILE "${dist}/win-x64/node.lib" "${dist}/x64/node.lib")
        file(MAKE_DIRECTORY "${TEST_DIR}/electron input/node_headers/include/node")
        file(COPY "${headers}/node.h" "${headers}/node_api.h"
            DESTINATION "${TEST_DIR}/electron input/node_headers/include/node")
        set(electron_archive "node-v${version}-headers.tar.gz")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${dist}/${electron_archive}" node_headers
            WORKING_DIRECTORY "${TEST_DIR}/electron input" COMMAND_ERROR_IS_FATAL ANY)
        file(SHA256 "${dist}/${electron_archive}" electron_hash)
        file(WRITE "${dist}/SHASUMS256.txt" "${electron_hash}  ${electron_archive}\n${library_hash}  x64/node.lib\n")
        _ungyp_fetch_sdk(electron "${version}" x64 "${mirror}" electron_root electron_library)
        if(electron_root STREQUAL root)
            message(FATAL_ERROR "Runtime caches must be separate")
        endif()
    endif()
else()
    if(CASE STREQUAL "offline_corrupt")
        _ungyp_fetch_sdk(node "${version}" x64 "${mirror}" root library)
        get_filename_component(cache "${root}/../.." ABSOLUTE)
        file(WRITE "${cache}/${archive}" "corrupted cached archive")
        file(REMOVE "${cache}/headers/ready")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${SOURCE_DIR}" "-DTEST_DIR=${TEST_DIR}"
        "-DCASE=${CASE}" -DCHILD=ON -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    set(pattern_checksum "SHA256 mismatch")
    set(pattern_offline "offline cache miss")
    set(pattern_offline_corrupt "SHA256 mismatch")
    set(pattern_missing_checksum "no SHA256 entry")
    set(pattern_invalid_archive "archive")
    if(status EQUAL 0 OR NOT "${output}${error}" MATCHES "${pattern_${CASE}}")
        message(FATAL_ERROR "Expected ${CASE} rejection, got ${status}: ${output}${error}")
    endif()
endif()
